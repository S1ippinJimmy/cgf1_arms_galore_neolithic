<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_BaseHumanMakeableRanged_Throwing">
		<defName>CGF1_MWP_ThrowingStones_</defName>
		<label>throwing stones</label>
		<description>A naturally occurring aggregate of mineral matter. Rocks can be found almost anywhere on most terrestrial bodies in space. These rocks are small enough to fit in the human hand and can be used as crude throwing weapons. Rocks were likely among the first weapons used by humans to kill other humans besides the human body itself, and they will likely be among the last to do so as well.</description>
		<graphicData>
			<texPath>CGF1/Ranged/ThrowingStones</texPath>
			<drawSize>0.95</drawSize>
		</graphicData>
		<soundInteract>ThrowGrenade</soundInteract>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
				<li>CraftingSpot</li>
				<li>FueledSmithy</li>
				<li>ElectricSmithy</li>
			</recipeUsers>
			<researchPrerequisite/>
			<skillRequirements/>
		</recipeMaker>
		<costStuffCount>5</costStuffCount>
		<stuffCategories>
			<li>CGF1_StuffCategory_Stony_NJ</li>
		</stuffCategories>
		<statBases>
			<WorkToMake>400</WorkToMake>
			<Mass>1</Mass>
			<AccuracyTouch>0.7</AccuracyTouch>
			<AccuracyShort>0.5</AccuracyShort>
			<AccuracyMedium>0.4</AccuracyMedium>
			<AccuracyLong>0.2</AccuracyLong>
			<RangedWeapon_Cooldown>2.0</RangedWeapon_Cooldown>
		</statBases>
		<relicChance>0.0</relicChance>
		<techLevel>Neolithic</techLevel>
